<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Spiel</title>
	<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='50' font-family='Times New Roman, Times, serif' font-size='100' fill='black' text-anchor='middle' dominant-baseline='central'%3ES%3C/text%3E%3C/svg%3E">
</head>
<body>
	<form id="auth" action="/auth" method="post">
		<label for="username">Логин</label>
		  <input
			id="login"
			placeholder="Логин" 
			type="text"
			name="username"
			autocomplete="username"
			required
		  >
		  <label for="password">Пароль</label>
		  <input
			id="password"
			type="password"
			name="password"
			placeholder="Пароль" 
			autocomplete="current-password"
			required
		  >
		<p id="errorMsg" style="color:red; margin-bottom: 10px;"></p>
		<button type="submit">Зарегистрироваться/Войти</button>
    </form>
	<div id="main" style="display:none;">
        <h2>Доброе утро!</h2>
        <button onclick="logout()">Выйти</button>
    </div>
	<!-- <div id="output">Загрузка...</div> -->
	<script id="embedded" type="module">
		<!-- #include(index.js) -->
    </script>
</body>
</html>
